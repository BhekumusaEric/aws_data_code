# Student Insights Pipeline - Environment Variables Template
# Copy this file to .env and fill in your values

# AWS Configuration
AWS_REGION=af-south-1
AWS_PROFILE=default

# S3 Buckets (will be created by CloudFormation)
RAW_BUCKET_NAME=student-insights-pipeline-raw-data-dev-123456789012
PROCESSED_BUCKET_NAME=student-insights-pipeline-processed-data-dev-123456789012

# Athena Configuration
ATHENA_DATABASE=student_insights_pipeline_database_dev
ATHENA_WORKGROUP=student-insights-pipeline-workgroup-dev
ATHENA_OUTPUT_LOCATION=s3://student-insights-pipeline-processed-data-dev-123456789012/athena-results/

# Lambda Configuration
LAMBDA_TIMEOUT=300
LAMBDA_MEMORY_SIZE=512

# Data Processing Configuration
BATCH_SIZE=100
MAX_RETRIES=3

# Environment
ENVIRONMENT=dev

# Logging
LOG_LEVEL=INFO

# Development/Testing (Optional)
LOCALSTACK_ENDPOINT=http://localhost:4566
